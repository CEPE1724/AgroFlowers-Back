{
  "info": {
    "_postman_id": "a6f2f3d0-6f2a-4f0e-9b1a-agroflowers001",
    "name": "AgroFlowers AI - API",
    "description": "Colección completa de endpoints de los 6 microservicios de negocio de AgroFlowers AI, organizada por carpetas. Todas las peticiones pasan por el gateway Nginx (http://localhost:8091). Antes de probar cualquier endpoint protegido, ejecuta una de las peticiones de la carpeta 'Autenticación' — el token se guarda automáticamente en la variable de colección {{token}} y el resto de peticiones ya lo usan como Bearer.\n\nNOTA IMPORTANTE SOBRE 2FA: todos los roles tienen TOTP obligatorio en Keycloak. El endpoint /api/auth/login (Direct Access Grant) puede rechazar el login si el usuario tiene un segundo factor pendiente de configurar. Para pruebas en Postman usa un usuario cuyo TOTP ya esté configurado, o crea un usuario de prueba y complétalo una vez desde el navegador antes de usarlo aquí.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "gatewayUrl", "value": "http://localhost:8091", "type": "string" },
    { "key": "keycloakUrl", "value": "http://localhost:8380", "type": "string" },
    { "key": "realm", "value": "agroflowers-realm", "type": "string" },
    { "key": "clientId", "value": "agroflowers-service-client", "type": "string" },
    { "key": "clientSecret", "value": "AQhIbs5ZBW059xYG1czX3QlSlH6XNfxa", "type": "string" },
    { "key": "username", "value": "coloca-un-usuario-valido", "type": "string" },
    { "key": "password", "value": "coloca-su-password", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "farmId", "value": "1", "type": "string" },
    { "key": "flowerId", "value": "34", "type": "string" },
    { "key": "purchaseId", "value": "1", "type": "string" },
    { "key": "shipmentId", "value": "1", "type": "string" },
    { "key": "saleId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "01 - Autenticación",
      "item": [
        {
          "name": "Login directo en Keycloak (recomendado para Postman)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password", "type": "text" },
                { "key": "client_id", "value": "{{clientId}}", "type": "text" },
                { "key": "client_secret", "value": "{{clientSecret}}", "type": "text" },
                { "key": "username", "value": "{{username}}", "type": "text" },
                { "key": "password", "value": "{{password}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": ["{{keycloakUrl}}"],
              "path": ["realms", "{{realm}}", "protocol", "openid-connect", "token"]
            },
            "description": "Obtiene el JWT directamente de Keycloak (Direct Access Grant). Rechazado (400/401) si el usuario tiene TOTP pendiente de configurar."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('token', json.access_token);",
                  "    console.log('Token guardado en {{token}}');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login vía auth-service",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/auth/login",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "PÚBLICO. Fachada de auth-service sobre Keycloak. Misma limitación de TOTP que el login directo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('token', json.accessToken);",
                  "    console.log('Token guardado en {{token}}');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar usuario (autoregistro, rol OPERADOR fijo)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"nuevo.operador\",\n  \"email\": \"nuevo.operador@agroflowers.com\",\n  \"firstName\": \"Nuevo\",\n  \"lastName\": \"Operador\",\n  \"password\": \"Password123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/auth/register",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "PÚBLICO. Crea el usuario en Keycloak y le asigna el rol OPERADOR automáticamente (hardcodeado en el backend)."
          }
        },
        {
          "name": "Crear usuario (solo ADMIN, rol SUPERVISOR o ADMIN)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"nueva.supervisora\",\n  \"email\": \"nueva.supervisora@agroflowers.com\",\n  \"firstName\": \"Nueva\",\n  \"lastName\": \"Supervisora\",\n  \"password\": \"Password123!\",\n  \"role\": \"SUPERVISOR\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/admin/users",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "admin", "users"]
            },
            "description": "Rol requerido: ADMIN. El campo role solo acepta SUPERVISOR o ADMIN (validado por regex en el backend)."
          }
        }
      ]
    },
